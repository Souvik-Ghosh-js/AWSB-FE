# Attar World Sonar Bangla — frontend environment
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Everything here is NEXT_PUBLIC_ and therefore SHIPPED TO THE BROWSER.
# No secret belongs in this file. The frontend never holds a DB credential,
# never holds RAZORPAY_KEY_SECRET, and never holds RAZORPAY_WEBHOOK_SECRET —
# those live only on the API instance.

# ---- API --------------------------------------------------------------
# Base URL of the Express API, including /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---- Razorpay ---------------------------------------------------------
# The PUBLISHABLE key id only. It is safe in the browser by design — it is
# what Razorpay Checkout is opened with. The secret stays on the API.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---- Site -------------------------------------------------------------
# Canonical public origin. Used for canonical URLs, OpenGraph, sitemap
# and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Media (optional) -------------------------------------------------
# Public base URL of the S3/Lightsail bucket serving product images. Used to
# allowlist the hostname for next/image. Leave blank to fall back to the API
# host.
NEXT_PUBLIC_MEDIA_BASE_URL=

# ---- Local visual development (optional) ------------------------------
# 'true' renders the storefront from src/lib/mock-data.ts instead of calling
# the API, so pages can be designed before the API is running. NEVER set this
# in production — it is read at build time and would serve fake products.
NEXT_PUBLIC_USE_MOCKS=false
